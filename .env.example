# PostgreSQL administrator identity is used only by the database service and
# manual administrator operations. Never pass it to the backend container.
POSTGRES_DB=hich_erp
POSTGRES_USER=hich_dev
POSTGRES_PASSWORD=replace-with-the-existing-local-admin-password

# Backend runtime and central migration identities.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hich_erp
DB_RUNTIME_USER=hich_runtime_dev
DB_RUNTIME_PASSWORD=replace-with-restricted-development-runtime-password
DB_MIGRATION_USER=hich_migrator_dev
DB_MIGRATION_PASSWORD=replace-with-restricted-development-migration-password

# Isolated integration-test database and identities.
TEST_DB_HOST=postgres
TEST_DB_PORT=5432
TEST_DB_NAME=hich_erp_test
TEST_DB_RUNTIME_USER=hich_runtime_test
TEST_DB_RUNTIME_PASSWORD=replace-with-restricted-test-runtime-password
TEST_DB_MIGRATION_USER=hich_migrator_test
TEST_DB_MIGRATION_PASSWORD=replace-with-restricted-test-migration-password

# Redis
REDIS_PASSWORD=replace-with-local-redis-password

# Optional application bootstrap settings
ERP_BOOTSTRAP_ADMIN_EMAIL=
ERP_BOOTSTRAP_ADMIN_PASSWORD=
ERP_COOKIE_SECURE=false
